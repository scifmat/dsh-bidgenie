{
  "schemaVersion": "1.0",
  "id": "custom-tech-minimal",
  "name": "我的技术方案样式（最小示例）",
  "label": "自定义-技术方案（最小示例）",
  "docType": "tech",
  "description": "从官方 official-tech 复制后精简的最小示例：颜色 auto、Windows 自带字体。复制到 dsh/styles/tech/ 并改 id 使用。",
  "basedOn": "official-tech",
  "params": {
    "fontFamily": "宋体",
    "headingFontFamily": "黑体",
    "fontLatin": "Times New Roman",
    "fontSizePt": 12,
    "lineSpacing": 1.5,
    "headingSizesPt": {
      "h1": 22,
      "h2": 18,
      "h3": 16,
      "h4": 15,
      "h5": 14,
      "h6": 12
    },
    "pageMarginMm": {
      "top": 20,
      "bottom": 20,
      "left": 19,
      "right": 19
    },
    "headingNumbering": true,
    "headingNumberingScheme": {
      "h1": "第%1章",
      "h2": "%1.%2",
      "h3": "%1.%2.%3",
      "h4": "%1.%2.%3.%4",
      "h5": "%1.%2.%3.%4.%5",
      "h6": "%1.%2.%3.%4.%5.%6"
    },
    "firstLineIndentChars": 2,
    "bodyAlignment": "justify",
    "title": {
      "fontFamily": "黑体",
      "fontSizePt": 22,
      "bold": true,
      "align": "center",
      "spaceAfterPt": 12,
      "fontLatin": "Arial",
      "color": "auto"
    },
    "table": {
      "autoFit": true,
      "cellAlign": "center",
      "cellVerticalAlign": "center",
      "headerBold": true,
      "headerShading": "D9D9D9",
      "fontSizePt": 10.5,
      "style": "Table Grid",
      "minColumnWidthCm": 1.2,
      "maxColumnWeight": 40,
      "fontFamily": "宋体",
      "fontLatin": "Times New Roman",
      "color": "auto"
    },
    "captions": {
      "tablePrefix": "▼表",
      "figurePrefix": "▲图",
      "fontSizePt": 10.5,
      "align": "center",
      "spaceBeforePt": 3,
      "spaceAfterPt": 6,
      "fontFamily": "宋体",
      "fontLatin": "Times New Roman",
      "color": "auto"
    },
    "captionPrefix": {
      "table": "▼表",
      "figure": "▲图"
    },
    "textColor": "auto",
    "headingColor": "auto",
    "captionColor": "auto",
    "tableColor": "auto"
  }
}
